    void primenumbers1to100()
    {
    	for(int n=1;n<=100;n++)
    	{
    		int count=0;
    		for(int i=1;i<=n;i++)
    		{
    			if(n%i==0)
    			{
    				count++;
    			}
    		}
    		if(count==2)
    		{
    			System.out.println(n+" ");
    		}
    	}
    }
    void sumofprimenumbers()
    {
    	int sum=0;
    	for(int n=1;n<=100;n++)
    	{
    		int count=0;
    		for(int i=1;i<=n;i++)
    		{
    			if(n%i==0)
    			{
    				count++;
    			}
    		}
    		if(count==2)
    		{
    			sum=sum+n;
    		}
    	}
    	System.out.println(sum);
    }
