	void pattern27()
	{
		/*
		 A B C D E
		 J I H G F
		 K L M N O
		 T S R Q P
		 U V W X Y
		 */
		char ch = 'A';
		for(int i=1;i<=5;i++)
		{
			if(i%2!=0)
			{
				for(int j=1;j<=5;j++)
				{
					System.out.print(ch+" ");
					ch++;
				}
			}
			else
			{
				ch=(char)(ch+4);

				for(int j=1;j<=5;j++)
				{
					System.out.print(ch+" ");
					ch--;
				}
				ch=(char)(ch+6);
			}
			System.out.println();
		}
		
		
	}
