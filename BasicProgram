	void program72()
	{
		//program to check given number is palindrome or not
		System.out.println("Enter Number: ");
		int n=sc.nextInt();
		int temp=n;
		int rev=0;
		while(temp>0)
		{
			int rem=temp%10;
			rev=rev*10+rem;
			temp=temp/10;

		}
		if(rev==n)
		{
