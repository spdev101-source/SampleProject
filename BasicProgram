	void check(int n,int i)
	{
		if(n<=1)
		{
			System.out.println("Not prime");
			return;
		}
		if(i==n)
		{
			System.out.println("Prime number");
			return;
		}
		if (n % i == 0) {
			System.out.println("Not Prime Number");
			return;
		}

		// Recursive call
		check(n, i + 1);
	}
