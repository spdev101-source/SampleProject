	void program66()
	{
		//Given number is armstrong or not
		System.out.println("Enter Number: ");
		int n=sc.nextInt();
		int temp=n;
		int sum=0;
		while(n>0)
		{
			int rem=n%10;
			sum=sum+(rem*rem*rem);
			n=n/10;
		}
		if(sum==temp)
		{
			System.out.println("Armstrong");
		}
		else
		{
			System.out.println("Not");
		}
	}
